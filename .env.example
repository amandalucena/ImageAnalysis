# Copie para .env e ajuste os valores: cp .env.example .env

# Ambiente da API (Development | Production)
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# PostgreSQL — armazenamento persistente dos resultados
POSTGRES_DB=imageanalysis
POSTGRES_USER=imageanalysis
POSTGRES_PASSWORD=imageanalysis
POSTGRES_PORT=5432

# Redis — cache de dados intermediários da análise
REDIS_PORT=6379

# RabbitMQ — fila de mensagens para o Analysis Worker
RABBITMQ_USER=imageanalysis
RABBITMQ_PASSWORD=imageanalysis
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
